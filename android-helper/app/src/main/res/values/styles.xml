<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework Material theme keeps native AlertDialog, EditText, buttons,
         text selection and confirmation sheets consistent with our own UI.
         Android 12+ system_* palette entries follow the user's wallpaper. -->
    <style name="MobileFIDOTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@android:color/system_accent1_600</item>
        <item name="android:colorControlActivated">@android:color/system_accent1_600</item>
        <item name="android:colorControlHighlight">@android:color/system_accent1_100</item>
        <item name="android:colorBackground">@android:color/system_neutral1_10</item>
        <item name="android:colorBackgroundFloating">@android:color/system_neutral1_0</item>
        <item name="android:windowBackground">@android:color/system_neutral1_10</item>
        <item name="android:textColorPrimary">@android:color/system_neutral1_900</item>
        <item name="android:textColorSecondary">@android:color/system_neutral2_600</item>
        <item name="android:statusBarColor">@android:color/system_neutral1_10</item>
        <item name="android:navigationBarColor">@android:color/system_neutral1_10</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
